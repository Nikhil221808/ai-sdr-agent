# Claude API key. Leave unset to run in demo mode.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5)
SDR_MODEL=

# Optional: Slack incoming webhook for review notifications (--slack)
SLACK_WEBHOOK_URL=

# Optional: HubSpot private app token with crm.objects.contacts.read/write (--hubspot)
HUBSPOT_TOKEN=
